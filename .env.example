# Copie este arquivo para .env.local e preencha os valores.
# .env.local NUNCA vai para o GitHub.

# Endereço do projeto no Supabase (pode ficar visível no navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable/anon) do Supabase (pode ficar visível no navegador)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRETO: endereço de conexão do banco (Session pooler), com a senha.
# Usado só para aplicar migrações e rodar testes no computador. Nunca vai para o navegador.
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@SEU-HOST.pooler.supabase.com:5432/postgres
